# ==============================================
# SpeakUp AI Environment Configuration
# ==============================================

# ----- Application Settings -----
NODE_ENV=development
APP_NAME=SpeakUp AI
APP_VERSION=1.0.0
PORT=3000

# ----- API Gateway Configuration -----
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=3000
API_GATEWAY_URL=http://localhost:3000

# ----- JWT Authentication -----
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_REFRESH_EXPIRATION=30d

# ----- Google Gemini API Configuration -----
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_PROJECT_ID=your_google_cloud_project_id

# Gemini Model Selection
GEMINI_MODEL_FAST=gemini-2.0-flash-live
GEMINI_MODEL_ADVANCED=gemini-2.5-flash-live
GEMINI_MODEL_AUDIO=gemini-2.5-flash-native-audio-dialog

# Gemini API Settings
GEMINI_ENABLE_STREAMING=true
GEMINI_MAX_TOKENS=2048
GEMINI_TEMPERATURE=0.7
GEMINI_TOP_P=0.95
GEMINI_TOP_K=40

# ----- Audio Configuration -----
AUDIO_SAMPLE_RATE=16000
AUDIO_ENCODING=LINEAR16
AUDIO_LANGUAGE_CODE=en-US
AUDIO_MAX_DURATION_SECONDS=60
AUDIO_CHUNK_SIZE=4096

# ----- Database Configuration -----

# PostgreSQL (User data, Progress, Metadata)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=speakup_ai
POSTGRES_USER=speakup_admin
POSTGRES_PASSWORD=change_this_password
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# MongoDB (History, Analytics, Logs)
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DB=speakup_ai
MONGODB_USER=speakup_admin
MONGODB_PASSWORD=change_this_password
MONGODB_URL=mongodb://${MONGODB_USER}:${MONGODB_PASSWORD}@${MONGODB_HOST}:${MONGODB_PORT}/${MONGODB_DB}

# ----- Redis Configuration (Caching & Sessions) -----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_this_password
REDIS_DB=0
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# ----- Service URLs (Microservices) -----
ASR_SERVICE_URL=http://localhost:3001
TTS_SERVICE_URL=http://localhost:3002
DIALOGUE_SERVICE_URL=http://localhost:3003
SCENARIOS_SERVICE_URL=http://localhost:3004
HISTORY_SERVICE_URL=http://localhost:3005
RECOMMENDATIONS_SERVICE_URL=http://localhost:3006
I18N_SERVICE_URL=http://localhost:3007
USER_SERVICE_URL=http://localhost:3008

# ----- Service Ports -----
ASR_SERVICE_PORT=3001
TTS_SERVICE_PORT=3002
DIALOGUE_SERVICE_PORT=3003
SCENARIOS_SERVICE_PORT=3004
HISTORY_SERVICE_PORT=3005
RECOMMENDATIONS_SERVICE_PORT=3006
I18N_SERVICE_PORT=3007
USER_SERVICE_PORT=3008

# ----- Logging Configuration -----
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_OUTPUT=stdout
ENABLE_REQUEST_LOGGING=true

# ----- CORS Configuration -----
CORS_ORIGIN=http://localhost:3000,http://localhost:19006
CORS_CREDENTIALS=true

# ----- Rate Limiting -----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ----- File Upload Configuration -----
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=audio/wav,audio/mp3,audio/mpeg,audio/webm

# ----- WebSocket Configuration -----
WS_ENABLED=true
WS_PATH=/ws
WS_HEARTBEAT_INTERVAL=30000

# ----- Learning Levels Configuration -----
DEFAULT_LEVEL=beginner
AVAILABLE_LEVELS=beginner,intermediate,advanced

# ----- Internationalization -----
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,ru,es,fr,de,zh

# ----- Analytics & Monitoring -----
ENABLE_ANALYTICS=true
GOOGLE_ANALYTICS_ID=your_ga_id_here
SENTRY_DSN=your_sentry_dsn_here

# ----- Email Configuration (Optional) -----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@speakup-ai.com

# ----- Cloud Storage (Optional) -----
# For storing audio files, user uploads, etc.
STORAGE_TYPE=local
AWS_S3_BUCKET=speakup-ai-storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# ----- Feature Flags -----
FEATURE_VOICE_MODE=true
FEATURE_TEXT_MODE=true
FEATURE_VIDEO_MODE=false
FEATURE_GROUP_SESSIONS=false
FEATURE_OFFLINE_MODE=false

# ----- Mobile App Configuration -----
MOBILE_APP_SCHEME=speakupai
MOBILE_DEEP_LINK_URL=speakupai://
MOBILE_APP_DOWNLOAD_URL=https://speakup-ai.com/download

# ----- Development Tools -----
ENABLE_SWAGGER_DOCS=true
ENABLE_GRAPHQL_PLAYGROUND=true
ENABLE_DEBUG_MODE=true

# ----- Testing Configuration -----
TEST_DATABASE_URL=postgresql://test_user:test_pass@localhost:5433/speakup_test
TEST_MONGODB_URL=mongodb://test_user:test_pass@localhost:27018/speakup_test
