{
  "name": "speakup-ai",
  "version": "1.0.0",
  "description": "AI-powered language learning companion with Gemini Live API",
  "private": true,
  "workspaces": [
    "services/*",
    "clients/*",
    "shared/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:*\"",
    "dev:gateway": "npm run dev --workspace=services/api-gateway",
    "dev:asr": "npm run dev --workspace=services/asr-service",
    "dev:tts": "npm run dev --workspace=services/tts-service",
    "dev:dialogue": "npm run dev --workspace=services/dialogue-service",
    "dev:scenarios": "npm run dev --workspace=services/scenarios-service",
    "dev:history": "npm run dev --workspace=services/history-service",
    "dev:recommendations": "npm run dev --workspace=services/recommendations-service",
    "dev:i18n": "npm run dev --workspace=services/i18n-service",
    "dev:user": "npm run dev --workspace=services/user-service",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "test:integration": "jest --config jest.integration.config.js",
    "test:e2e": "jest --config jest.e2e.config.js",
    "test:coverage": "npm run test -- --coverage",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "k8s:apply": "kubectl apply -f infrastructure/kubernetes/",
    "k8s:delete": "kubectl delete -f infrastructure/kubernetes/",
    "db:migrate": "npm run migrate --workspace=services/user-service",
    "db:seed": "npm run seed --workspace=services/user-service",
    "generate-qr": "node scripts/generate-qr.js",
    "docs:api": "npm run docs --workspace=services/api-gateway",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "ai",
    "language-learning",
    "english",
    "gemini-api",
    "speech-recognition",
    "react-native",
    "microservices",
    "education"
  ],
  "author": "SpeakUp AI Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/speakup-ai.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/speakup-ai/issues"
  },
  "homepage": "https://github.com/yourusername/speakup-ai#readme"
}
